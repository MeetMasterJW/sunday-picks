rules_version = '2';

// Sunday Picks: anyone with the link can read and make picks. Only the parent
// login can unlock a week or change family names. Deletes are blocked.
// Weeks 1-18 are the regular season; 19-22 are Wild Card, Divisional, Conference and Super Bowl.
// Player PINs are checked by the page; these rules only stop a PIN that's already set
// from being replaced by anyone but a parent.
service cloud.firestore {
  match /databases/{database}/documents {

    // User UID of the parent login (Firebase console → Authentication → Users)
    function isParent() {
      return request.auth != null && request.auth.uid == 'xo2wudx6HNYXcsVgUdLMgEmU6nA3';
    }

    function weekLocked(week) {
      let lock = /databases/$(database)/documents/locks/$('w' + string(week));
      return exists(lock) && get(lock).data.locked == true;
    }

    // The Monday night guess is a second tiebreaker, and Monday is after the week locks,
    // so it may be added to a locked week — but only on its own. Picks and the first
    // guess must come back byte for byte unchanged.
    function onlySecondGuess() {
      return resource != null
        && request.resource.data.picks == resource.data.picks
        && request.resource.data.week == resource.data.week
        && request.resource.data.player == resource.data.player
        && request.resource.data.get('tb', -1) == resource.data.get('tb', -1)
        && request.resource.data.get('tbAt', '') == resource.data.get('tbAt', '');
    }

    match /picks/{id} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['week', 'player', 'picks', 'tb', 'tbAt', 'tb2', 'tb2At'])
        && request.resource.data.week is int
        && request.resource.data.week >= 1 && request.resource.data.week <= 22
        && request.resource.data.player.matches('p[1-8]')
        && id == 'w' + string(request.resource.data.week) + '-' + request.resource.data.player
        && request.resource.data.picks is map
        && (isParent() || !weekLocked(request.resource.data.week) || onlySecondGuess());
    }

    // Any phone can write the auto-lock once everyone's picks are in; locking by hand
    // and unlocking are for a parent.
    match /locks/{id} {
      allow read: if true;
      allow create, update: if id.matches('w([1-9]|1[0-9]|2[0-2])')
        && request.resource.data.keys().hasOnly(['week', 'locked', 'auto', 'at'])
        && request.resource.data.locked is bool
        && (isParent()
          || (request.resource.data.locked == true && request.resource.data.get('auto', false) == true));
    }

    match /config/family {
      allow read: if true;
      allow create, update: if isParent()
        && request.resource.data.keys().hasOnly(['players'])
        && request.resource.data.players is list
        && request.resource.data.players.size() >= 2
        && request.resource.data.players.size() <= 8;
    }

    // A PIN can be set when there isn't one yet (first time, or after a parent reset);
    // after that only a parent can change it. Photos and colors save with the PIN untouched.
    function pinUntouched() {
      return resource != null
        && request.resource.data.get('pinHash', '') == resource.data.get('pinHash', '')
        && request.resource.data.get('pinSalt', '') == resource.data.get('pinSalt', '');
    }
    function noPinYet() {
      return resource == null || resource.data.get('pinHash', '') == '';
    }

    // Each person's color, photo (a small JPEG data URL) and hashed PIN
    match /profiles/{id} {
      allow read: if true;
      allow create, update: if id.matches('p[1-8]')
        && request.resource.data.keys().hasOnly(['color', 'avatar', 'pinHash', 'pinSalt', 'updatedAt'])
        && request.resource.data.get('avatar', '') is string
        && request.resource.data.get('avatar', '').size() < 200000
        && (isParent() || pinUntouched() || noPinYet());
    }

    // Pregame favorites per week, saved so upset badges work for everyone
    match /lines/{id} {
      allow read: if true;
      allow create, update: if id.matches('w([1-9]|1[0-9]|2[0-2])')
        && request.resource.data.size() <= 24;
    }
  }
}
